# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# source Excel trackers are proprietary/sensitive data, imported into the DB — not committed
*.xlsx
*.xls

.env*.local

# Claude Code local session state (shared agent config below is committed)
/.claude/*
!/.claude/settings.json
!/.claude/agents/
!/.claude/workflows/
!/.claude/hooks/

# credential notes kept locally -- never commit
/AMC Score Supabase link/
*supabase*.txt
*credentials*
*.secret
*.secrets

# one-off investigation scripts (run from repo root: npx dotenv -e .env.local -- npx tsx scratch/<file>.ts)
/scratch/

# Local-only data and analysis projects (kept on this machine, never published)
/3 Year AMFI Data/
/backtesting/
/crosscheck/
/gold-silver-exit-aum-template.csv
